{
  "name": "docs-cli",
  "version": "0.1.0",
  "description": "JavaScript CLI for the Docs Pipeline API",
  "type": "module",
  "bin": {
    "docs": "./bin/docs.js"
  },
  "scripts": {
    "check": "node --check ./bin/docs.js && node --check ./src/*.js",
    "test": "node --test",
    "start": "node ./bin/docs.js",
    "test:smoke": "node ./bin/docs.js help"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
